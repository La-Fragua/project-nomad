# Copy to .env in this directory (install/unraid/.env). Compose Manager loads it
# automatically. Do not commit .env.

# Host path for MySQL, Redis, and all NOMAD content (ZIMs, maps, Qdrant, etc.).
# Keep this on an Unraid share. Do not point it at the git clone.
NOMAD_DATA_DIR=/mnt/user/appdata/project-nomad

# Browser URL you will use to open NOMAD (LAN IP of the Unraid box, not localhost).
URL=http://YOUR_UNRAID_LAN_IP:8080

# Host port for the Command Center. Change if 8080 is already taken.
NOMAD_PORT=8080

# Must be at least 16 characters. Change this.
APP_KEY=change-me-unraid-nomad

# Used for both MySQL root/user and the admin DB_PASSWORD. Change this.
MYSQL_PASSWORD=nomad_unraid

# Optional. Attach AI Assistant to Unraid's existing Ollama instead of creating
# nomad_ollama. Leave blank to skip AI until you configure it in the UI.
# Host Ollama must listen on 0.0.0.0:11434 (published port).
# Knowledge-base embeddings still run: NOMAD installs Qdrant locally and sends
# embed requests to this Ollama (pull nomic-embed-text:v1.5 there if needed).
NOMAD_REMOTE_OLLAMA_URL=http://host.docker.internal:11434
